# ==========================================
# Configuracoes do Servidor Backend
# ==========================================
PORT=3000

# ==========================================
# Configuracoes do Banco de Dados (PostgreSQL / Neon)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=seu_usuario_aqui
DB_PASSWORD=sua_senha_aqui
DB_NAME=quizarena
# Em producao no Neon Free, use a URL pooled (-pooler) em DATABASE_URL
DATABASE_URL="postgresql://seu_usuario_aqui:sua_senha_aqui@localhost:5432/quizarena?schema=public"
# URL direta (sem -pooler no Neon) exigida pelo Prisma para executar migrations
DIRECT_URL="postgresql://seu_usuario_aqui:sua_senha_aqui@localhost:5432/quizarena?schema=public"

# ==========================================
# Configuracoes de Autenticacao (JWT)
# ==========================================
JWT_SECRET=sua_chave_secreta_jwt_aqui

# ==========================================
# Configuracoes do Supabase (Reservado)
# ==========================================
SUPABASE_URL=sua_url_do_supabase_aqui
SUPABASE_KEY=sua_chave_do_supabase_aqui

# ==========================================
# Configuracoes de Frontend e SMTP (Recuperacao de Senha)
# ==========================================
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp
SMTP_PASSWORD=senha_smtp
SMTP_FROM="QuizArena <noreply@quizarena.local>"
