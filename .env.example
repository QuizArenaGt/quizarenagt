# ==========================================
# Configuracoes do Servidor Backend
# ==========================================
PORT=3000

# ==========================================
# Configuracoes do Banco de Dados Local (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=seu_usuario_aqui
DB_PASSWORD=sua_senha_aqui
DB_NAME=quizarena
DATABASE_URL="postgresql://seu_usuario_aqui:sua_senha_aqui@localhost:5432/quizarena?schema=public"

# ==========================================
# Configuracoes de Autenticacao (JWT)
# ==========================================
JWT_SECRET=sua_chave_secreta_jwt_aqui

# ==========================================
# Configuracoes do Supabase (Reservado)
# ==========================================
SUPABASE_URL=sua_url_do_supabase_aqui
SUPABASE_KEY=sua_chave_do_supabase_aqui
