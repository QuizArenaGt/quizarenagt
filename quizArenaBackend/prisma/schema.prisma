generator client {
  provider = "prisma-client-js"
}

// Nota Prisma 6: índices parciais ("games_one_active_per_room_key", "rounds_one_open_per_game_key")
// e triggers SQL de imutabilidade/integridade residem nas migrations SQL e devem ser preservados
// manualmente usando `npx prisma migrate dev --create-only` antes de aplicar novas migrations.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
  HOST
}

model User {
  id                 String       @id @default(uuid())
  name               String
  email              String       @unique
  password           String
  role               Role         @default(USER)
  tokenVersion       Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  gameParticipations GamePlayer[]

  hostedRooms Room[]

  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

enum QuestionType {
  TRUE_FALSE
  MULTIPLE_CHOICE
}

model Question {
  id        String       @id @default(uuid())
  statement String
  type      QuestionType
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  roomId    String
  room      Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)

  options QuestionOption[]

  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid())
  text       String
  isCorrect  Boolean  @default(false)
  position   Int
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@map("question_options")
}

enum GameMode {
  CLASSIC
  HARDCORE
}

enum RoomStatus {
  ACTIVE
  ARCHIVED
}

enum GameStatus {
  WAITING
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum RoundStatus {
  OPEN
  CLOSED
}

enum GamePlayerStatus {
  ACTIVE
  LEFT
  ABANDONED
}

model Room {
  id           String       @id @default(uuid())
  code         String       @unique
  name         String?
  theme        String?
  hostId       String
  maxPlayers   Int
  questionTime Int
  gameMode     GameMode     @default(CLASSIC)
  status       RoomStatus   @default(ACTIVE)
  archivedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  questions    Question[]
  games        Game[]

  host User @relation(fields: [hostId], references: [id], onDelete: Restrict)

  @@index([hostId, status, createdAt(sort: Desc)])
  @@map("rooms")
}

model GamePlayer {
  id                  String           @id @default(uuid())
  gameId              String
  userId              String?
  nickname            String
  avatarId            String           @default("explorer")
  status              GamePlayerStatus @default(ACTIVE)
  score               Int              @default(0)
  joinedAt            DateTime         @default(now())
  disconnectedAt      DateTime?
  reconnectDeadlineAt DateTime?
  sessionTokenHash    String?          @unique

  game    Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers RoundAnswer[]

  // Índice único parcial criado via migration SQL: game_players_active_gameId_nickname_key em ("gameId", "nickname") WHERE status = 'ACTIVE'
  @@index([gameId, nickname])
  @@unique([gameId, userId])
  @@index([gameId, joinedAt(sort: Asc)])
  @@index([gameId, status])
  @@index([status, reconnectDeadlineAt])
  @@map("game_players")
}

model RoomQuestionSnapshot {
  id        String   @id @default(uuid())
  gameId    String   @unique
  createdAt DateTime @default(now())

  game      Game                           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  questions RoomQuestionSnapshotQuestion[]

  @@map("room_question_snapshots")
}

model RoomQuestionSnapshotQuestion {
  id               String       @id @default(uuid())
  sourceQuestionId String
  statement        String
  type             QuestionType
  position         Int
  snapshotId       String
  rounds           Round[]

  snapshot RoomQuestionSnapshot         @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  options  RoomQuestionSnapshotOption[]

  @@unique([snapshotId, position])
  @@map("room_question_snapshot_questions")
}

model RoomQuestionSnapshotOption {
  id                 String  @id @default(uuid())
  sourceOptionId     String
  text               String
  isCorrect          Boolean @default(false)
  position           Int
  questionSnapshotId String

  questionSnapshot RoomQuestionSnapshotQuestion @relation(fields: [questionSnapshotId], references: [id], onDelete: Cascade)
  answers          RoundAnswer[]

  @@unique([questionSnapshotId, position])
  @@map("room_question_snapshot_options")
}

model Game {
  id               String                @id @default(uuid())
  roomId           String
  status           GameStatus            @default(WAITING)
  maxPlayers       Int
  questionTime     Int
  gameMode         GameMode              @default(CLASSIC)
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  room             Room                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  players          GamePlayer[]
  questionSnapshot RoomQuestionSnapshot?
  rounds           Round[]

  @@index([roomId, createdAt(sort: Desc)])
  @@index([roomId, status])
  @@map("games")
}

model Round {
  id                 String      @id @default(uuid())
  gameId             String
  snapshotQuestionId String
  roundNumber        Int
  status             RoundStatus @default(OPEN)
  openedAt           DateTime    @default(now())
  expiresAt          DateTime
  closedAt           DateTime?
  timeLimit          Int

  game             Game                         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  snapshotQuestion RoomQuestionSnapshotQuestion @relation(fields: [snapshotQuestionId], references: [id], onDelete: Cascade)
  answers          RoundAnswer[]

  @@unique([gameId, roundNumber])
  @@unique([gameId, snapshotQuestionId])
  // Índice parcial criado via migration SQL: rounds_open_expiresAt_idx em ("expiresAt") WHERE status = 'OPEN'
  @@map("rounds")
}

model RoundAnswer {
  id           String   @id @default(uuid())
  roundId      String
  gamePlayerId String
  optionId     String
  answeredAt   DateTime @default(now())
  isCorrect    Boolean
  points       Int      @default(0)

  round      Round                      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  gamePlayer GamePlayer                 @relation(fields: [gamePlayerId], references: [id], onDelete: Cascade)
  option     RoomQuestionSnapshotOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([roundId, gamePlayerId])
  @@map("round_answers")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
